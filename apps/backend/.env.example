# Copy to `.env` and fill in. Values here are safe local defaults, NOT secrets.
# Validated by src/config/env.js on boot — the process refuses to start if invalid.

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# --- Postgres ---------------------------------------------------------------
# Local portable cluster lives in .postgres/ and listens on 5433 (see npm run db:start).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/minerva_dev
DATABASE_POOL_MAX=10

# --- Auth -------------------------------------------------------------------
# Two SEPARATE secrets, min 32 chars each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-48-byte-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-DIFFERENT-random-48-byte-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# --- Razorpay (required in production only) ---------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Telegram (required in production only) ---------------------------------
# Bot token also acts as the HMAC key verifying Telegram Login Widget payloads.
TELEGRAM_BOT_TOKEN=
# Channel/group the bot manages, e.g. -1001234567890
TELEGRAM_CHANNEL_ID=
# Arbitrary secret echoed by Telegram in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
