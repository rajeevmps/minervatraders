# Copy to `.env.local` and fill in.
# NEXT_PUBLIC_* values are baked into the client bundle at BUILD time and are
# publicly visible. Never put a secret here.

NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Razorpay publishable key id (safe to expose; the secret stays server-side).
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Bot username (no @) used by the Telegram Login Widget.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
